    {
      "parameters": {
        "jsCode": "const HOSTS = ['x.com', 'twitter.com', 'codex-resets.com'];\nfunction validUrl(u) {\n  return typeof u === 'string' && /^https:\\/\\/x\\.com\\/thsottiaux\\/status\\/\\d+$/.test(u) ? u : null;\n}\nfunction iso(v) {\n  if (!v) return null;\n  const d = new Date(v);\n  return isNaN(d.getTime()) ? null : d.toISOString();\n}\nlet rows = [];\nlet state = {};\ntry { rows = $('Get Cached Records').all().map(i => i.json).filter(r => r && r.record_key && !r.error); } catch (e) { rows = []; }\ntry { state = ($('Get Sync State').all().map(i => i.json).find(r => r && r.state_key === 'main')) || {}; } catch (e) { state = {}; }\n\nconst entries = [], resets = [], updates = [];\nconst seen = { entry: new Set(), reset: new Set(), update: new Set() };\nfor (const r of rows) {\n  const id = String(r.entry_id || '');\n  const url = r.author === 'thsottiaux' && /^https:\\/\\/(?:www\\.)?(?:x\\.com|twitter\\.com)\\/thsottiaux\\/status\\/\\d+$/.test(r.url || '') ? validUrl(r.url) : null;\n  if (!id || !url || !seen[r.record_type] || seen[r.record_type].has(id)) continue;\n  seen[r.record_type].add(id);\n  if (r.record_type === 'entry') {\n    const day = Number(r.day);\n    if (!Number.isInteger(day) || day < 1 || day > 28) continue;\n    entries.push({ id, day, kind: r.kind === 'reset' ? 'reset' : 'improvement', title: r.title || '', summary: r.summary || '', url, _o: Number(r.sort_order) || 0 });\n  } else if (r.record_type === 'reset') {\n    resets.push({ id, kind: r.kind === 'banked' ? 'banked' : 'regular', announcedAt: iso(r.announced_at), url });\n  } else if (r.record_type === 'update') {\n    const kind = ['post', 'improvement', 'reset'].includes(r.kind) ? r.kind : 'post';\n    updates.push({ id, author: r.author || '', lab: r.lab || '', kind, title: r.title || '', summary: r.summary || '', announcedAt: iso(r.announced_at), url });\n  }\n}\nentries.sort((a, b) => a.day - b.day || a._o - b._o);\nfor (const e of entries) delete e._o;\nconst byDateDesc = (a, b) => String(b.announcedAt || '').localeCompare(String(a.announcedAt || ''));\nresets.sort(byDateDesc);\nupdates.sort(byDateDesc);\n\nconst populated = entries.length + resets.length + updates.length > 0;\nconst base = { version: 1, startDate: '2026-10-05', timezone: 'America/Los_Angeles' };\nconst source = 'https://codex-resets.com/tibo-28';\nconst body = populated\n  ? { ...base, syncedAt: iso(state.synced_at) || iso(rows.map(r => r.synced_at).sort().pop()), entries, resets, updates, source }\n  : { ...base, error: 'unavailable', syncedAt: null, entries: [], resets: [], updates: [], source };\nreturn [{ json: { populated, body } }];"
      },
