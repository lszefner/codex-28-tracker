    {
      "parameters": {
        "jsCode": "const rows = $('Diff & Build Rows').all().map(i=>i.json);\nconst byId = new Map();\nfor (const r of rows) {\n  if (r.seeded || r.author !== 'thsottiaux') continue;\n  if (r.record_type !== 'reset' && !(r.record_type === 'entry' && r.kind === 'improvement')) continue;\n  if (!byId.has(r.entry_id) || r.record_type === 'reset') byId.set(r.entry_id,r);\n}\nconst esc = s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nreturn [...byId.values()].map(r=>({json:{entry_id:r.entry_id, first_seen_at:r.first_seen_at,\n  category:r.record_type==='reset'?'resets':'improvements',\n  text:(r.record_type==='reset'?'Codex limits just reset ('+esc(r.kind)+').':'New Codex improvement: '+esc(r.title))+'\\n'+esc(r.url)}}));"
      },
