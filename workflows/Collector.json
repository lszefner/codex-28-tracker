    {
      "parameters": {
        "jsCode": "const fetched = $('Run Fetch Sources').first().json;\nconst cached = $input.all().map(i => i.json).filter(r => r && r.record_key);\nconst byKey = {};\nfor (const r of cached) byKey[r.record_key] = r;\nconst firstRun = cached.length === 0;\nconst authorsWithPosts = new Set(cached.filter(r => r.record_type === 'update' && r.kind === 'post').map(r => r.author));\nconst now = new Date().toISOString();\n\nconst rows = [];\nconst seenKeys = new Set();\nfunction push(r) {\n  const key = r.record_type + ':' + r.entry_id;\n  if (seenKeys.has(key)) return;\n  seenKeys.add(key);\n  const prev = byKey[key];\n  const isNew = !prev;\n  let seeded = false;\n  if (isNew) {\n    seeded = firstRun || (r.record_type === 'update' && r.kind === 'post' && !authorsWithPosts.has(r.author));\n  } else {\n    seeded = prev.seeded === true;\n  }\n  rows.push({ json: {\n    record_key: key,\n    record_type: r.record_type,\n    entry_id: r.entry_id,\n    day: r.day ?? null,\n    kind: r.kind || '',\n    title: r.title || '',\n    summary: r.summary || '',\n    url: r.url,\n    author: r.author || '',\n    lab: r.lab || '',\n    announced_at: r.announced_at || '',\n    sort_order: r.sort_order ?? null,\n    seeded,\n    first_seen_at: isNew ? now : (prev.first_seen_at || now),\n    synced_at: now,\n    is_new: isNew,\n  } });\n}\n\nfor (const e of fetched.entries || []) {\n  if (!e || !e.id || !e.url) continue;\n  push({ record_type: 'entry', entry_id: String(e.id), day: e.day, kind: e.kind, title: e.title, summary: e.summary, url: e.url, author: 'thsottiaux', lab: 'OpenAI', announced_at: new Date(Number((BigInt(e.id) >> 22n) + 1288834974657n)).toISOString(), sort_order: e.sortOrder });\n}\nfor (const r of fetched.resets || []) {\n  if (!r || !r.id || !r.url) continue;\n  push({ record_type: 'reset', entry_id: String(r.id), kind: r.kind, title: 'Codex usage limits reset (' + r.kind + ')', summary: '', url: r.url, author: 'thsottiaux', lab: 'OpenAI', announced_at: r.announcedAt || '' });\n}\nfor (const u of fetched.updates || []) {\n  if (!u || !u.id || !u.url) continue;\n  push({ record_type: 'update', entry_id: String(u.id), kind: u.kind, title: u.title, summary: u.summary, url: u.url, author: u.author, lab: u.lab, announced_at: u.announcedAt || '' });\n}\nreturn rows;"
      },
