    {
      "parameters": {
        "jsCode": "const sent = new Set($input.all().map(i=>i.json).filter(r=>r.status==='sent').map(r=>r.delivery_key));\nconst subs = $('Get Active Subscribers').all().map(i=>i.json).filter(s=>s.chat_id && s.subscribed===true);\nconst alerts = $('Collect New Alerts').all().map(i=>i.json);\nconst out=[]; const seen=new Set();\nfor (const s of subs) for (const a of alerts) {\n  if (s.alert_mode && s.alert_mode!=='all' && s.alert_mode!==a.category) continue;\n  if (s.subscribed_at && new Date(a.first_seen_at)<new Date(s.subscribed_at)) continue;\n  const key=String(s.chat_id)+':'+a.entry_id;\n  if(sent.has(key)||seen.has(key))continue;\n  seen.add(key);out.push({json:{delivery_key:key,chat_id:String(s.chat_id),entry_id:a.entry_id,text:a.text}});\n}\nreturn out;"
      },
