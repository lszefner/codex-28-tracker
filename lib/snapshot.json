  "entries": [
    {
      "id": "2109430343346581527",
      "day": 7,
      "kind": "improvement",
      "title": "Larger default context for GPT-6.1 Sol",
      "summary": "GPT-6.1 Sol now defaults to 500k context in Codex and Work, up from 272k, helping reduce compactions and retain context during long tasks.",
      "url": "https://x.com/thsottiaux/status/2109430343346581527"
    },
    {
      "id": "2109132167112782291",
      "day": 6,
      "kind": "reset",
      "title": "Usage limits reset for everyone",
      "summary": "“Put the reset in the bag. All propagated.”",
      "url": "https://x.com/thsottiaux/status/2109132167112782291"
    },
    {
      "id": "2108777962053292398",
      "day": 5,
      "kind": "improvement",
      "title": "Use ChatGPT plans with Devin",
      "summary": "Users can now connect a personal ChatGPT Go, Plus, or Pro plan to Devin, with GPT model usage drawing from their ChatGPT plan quota.",
      "url": "https://x.com/thsottiaux/status/2108777962053292398"
    },
    {
      "id": "2108773703064657936",
      "day": 5,
      "kind": "improvement",
      "title": "Dots can delegate Codex work and edit Scheduled Tasks",
      "summary": "Your dot can now start and follow up on Codex work using context from ChatGPT conversations, Codex threads, and automations. It can also review and edit Scheduled Tasks in ChatGPT Work.",
      "url": "https://x.com/thsottiaux/status/2108773703064657936"
    },
    {
      "id": "2108645667451318747",
      "day": 5,
      "kind": "improvement",
      "title": "Composer predictions in the Codex desktop app",
      "summary": "Now available in beta for Pro users, composer predictions suggest your next message based on your conversation and how you communicate with Codex. The feature does not consume plan usage.",
      "url": "https://x.com/thsottiaux/status/2108645667451318747"
    },
    {
      "id": "2108275041276420573",
      "day": 4,
      "kind": "improvement",
      "title": "Instant steering and GPT-6.1 Sol ultrafast",
      "summary": "Steering now responds instantly to user adjustments for real-time course correction. GPT-6.1 Sol ultrafast is also rolling out in the API, Codex, and ChatGPT Work.",
      "url": "https://x.com/thsottiaux/status/2108275041276420573"
    },
    {
      "id": "2108040921044639779",
      "day": 3,
      "kind": "reset",
      "title": "A banked reset for everyone",
      "summary": "“Confirmed landed across all accounts. How are we doing so far?”",
      "url": "https://x.com/thsottiaux/status/2108040921044639779"
    },
    {
      "id": "2108084615349170480",
      "day": 3,
      "kind": "improvement",
      "title": "Codex Cloud connects through Tailscale",
      "summary": "Codex Cloud can now securely connect to resources on your tailnet using Tailscale.",
      "url": "https://x.com/thsottiaux/status/2108084615349170480"
    },
    {
      "id": "2107912709715132482",
      "day": 3,
      "kind": "improvement",
      "title": "GPT-6 update with Intelligent UI",
      "summary": "A new GPT-6 version and Intelligent UI are rolling out to everyone in ChatGPT, adding visual, interactive answers and tools for users’ tasks.",
      "url": "https://x.com/thsottiaux/status/2107912709715132482"
    },
    {
      "id": "2107676072871600470",
      "day": 2,
      "kind": "reset",
      "title": "Usage limits reset for everyone",
      "summary": "“We shipped four things that were deemed good to great and some math proofs, but the vote is clear and the community demands a reset. I did calibrate it and it *seems* that the game is rigged in reset's favor, but such are the rules at the moment.\n\nTherefore ... the reset has been”",
      "url": "https://x.com/thsottiaux/status/2107676072871600470"
    },
    {
      "id": "2107574912349303197",
      "day": 2,
      "kind": "improvement",
      "title": "Decisions API is live in public beta",
      "summary": "Developers can use the Decisions API to pick a model, tool, or action in near real time. It is available to all developers in public beta and decides up to 10x faster than GPT-6 Luna through the Responses API.",
      "url": "https://x.com/thsottiaux/status/2107574912349303197"
    },
    {
      "id": "2107573405553938664",
      "day": 2,
      "kind": "improvement",
      "title": "Meetings plugin saves notes and next steps",
      "summary": "The Meetings plugin takes notes and saves a personalized summary and next steps in ChatGPT Space. It is in beta for Pro and Business users in the ChatGPT desktop app on macOS.",
      "url": "https://x.com/thsottiaux/status/2107573405553938664"
    },
    {
      "id": "2107548725359104441",
      "day": 2,
      "kind": "improvement",
      "title": "Easier qualification for higher API rate limits",
      "summary": "Paid OpenAI API usage tiers go from five to three: Build, Launch, and Grow. Grow, the new highest tier, now qualifies with $500 in total API payments, down from $1,000.",
      "url": "https://x.com/thsottiaux/status/2107548725359104441"
    },
    {
      "id": "2107368734981517634",
      "day": 2,
      "kind": "improvement",
      "title": "Free Auto-review for all ChatGPT-signed-in users",
      "summary": "Auto-review is now free for all users signed in through a ChatGPT account. Enable it in permission settings to have a second agent review actions during long tasks, without drawing usage from your plan.",
      "url": "https://x.com/thsottiaux/status/2107368734981517634"
    },
    {
      "id": "2107158998495748264",
      "day": 1,
      "kind": "improvement",
      "title": "About 50% faster default speed for GPT-6 Astra and GPT-6.1 Sol",
      "summary": "Default speed has been optimized across subscription products and partners using Sign in With ChatGPT. The improvement is rolling out within two hours, with no user action needed.",
      "url": "https://x.com/thsottiaux/status/2107158998495748264"
    }
  ],
